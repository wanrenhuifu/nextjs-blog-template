# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# IDE / 本地验证产物
.qoder/
.zcode/
/verify-shots/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# …但示例文件要提交：它是配置项的文档，且不含任何真实凭据
!.env.example

# 搜索索引是构建产物（scripts/generate-search-index.mjs 生成），
# 每次 build 重新产出，不入库
/public/search-index.json

# 编辑器 / 工具的本机配置，可能含绝对路径
.claude/settings.local.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
