{
  "name": "nextjs-blog-template",
  "version": "0.1.0",
  "private": true,
  "description": "静态个人博客模板：Next.js 静态导出、双主题（日间竹林 / 夜间星月）、MDX 写作、全文搜索、工具集与数据面板",
  "license": "MIT",
  "keywords": [
    "blog",
    "template",
    "nextjs",
    "static-site",
    "mdx",
    "tailwindcss",
    "github-pages"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/keepalive-waline.mjs && node scripts/generate-search-index.mjs && next build && node scripts/prune-out.mjs",
    "build:verify": "node scripts/generate-search-index.mjs && next build && node scripts/prune-out.mjs",
    "start": "npx --yes serve out",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "og": "node scripts/generate-og.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "avatars": "node scripts/fetch-avatars.mjs"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@waline/client": "^3.15.2",
    "framer-motion": "^12.40.0",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "katex": "^0.17.0",
    "lucide-react": "^1.17.0",
    "next": "16.2.6",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rehype-katex": "^7.0.1",
    "rehype-pretty-code": "^0.14.3",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.34.5",
    "shiki": "^4.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "playwright-chromium": "^1.60.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
